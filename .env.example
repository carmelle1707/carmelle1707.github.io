# Copie ce fichier en .env.local puis remplis chaque valeur.
# Ne commite jamais .env.local : il contient tes secrets.

# --- Site ---
# Adresse publique du site (sans / final). En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- MongoDB Atlas ---
# Atlas > Database > Connect > Drivers. Remplace <password> et ajoute le nom de la base
# après le / : ...mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_URI=

# --- Auth.js (connexion admin) ---
# Facultatif : sans valeur, une clé est dérivée de MONGODB_URI. Sinon : `npx auth secret`
AUTH_SECRET=
# Compte admin créé au premier démarrage sur une base vide (ou par `npm run seed`).
# Le mot de passe est hashé avec bcrypt, jamais stocké en clair. 12 caractères minimum.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Vercel Blob (photo, CV, captures des projets) ---
# Vercel > Storage > Create > Blob, puis onglet .env.local
BLOB_READ_WRITE_TOKEN=

# --- Resend (emails du formulaire de contact) ---
# resend.com > API Keys > Create API Key (permission « Sending access »)
RESEND_API_KEY=
# Expéditeur : onboarding@resend.dev tant que tu n'as pas vérifié de domaine sur Resend
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
# Adresse qui reçoit les messages du formulaire
CONTACT_TO_EMAIL=angecarmellegbedji@gmail.com

# --- Anti-spam ---
# Sel pour hasher les IP. Facultatif : sans valeur, il est dérivé de MONGODB_URI
RATE_LIMIT_SALT=
